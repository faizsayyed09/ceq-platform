APP_ENV=development
LOG_LEVEL=INFO
GENESYS_REGION=mypurecloud.com
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
ALLOW_MANUAL_TOKEN_TESTING=false
PHI_PROTECTION_MODE=AUDIT_MODE
MAX_FILE_SIZE_MB=500
MAX_AUDIO_DURATION_SECONDS=14400
REPORT_DIR=/app/generated_reports
HF_HOME=/app/cache/huggingface
WHISPER_MODEL_CACHE=/app/models/whisper
RECORDING_STORAGE_PATH=/app/recordings
RECORDING_RETENTION_HOURS=
PYTHONPATH=/app/ceq-components:/app
